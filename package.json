{
  "name": "frame-shift-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"FRAME_SHIFT_HOME=test-videos/ bun --watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "FRAME_SHIFT_HOME=test-videos/ bun --watch server/index.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build server/index.ts --target=bun --outfile=dist/server.js --format=esm",
    "preview": "vite preview",
    "start": "NODE_ENV=production bun run dist/server.js",
    "test": "bun test",
    "test:run": "bun test",
    "test:ui": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@sentry/bun": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-router-devtools": "^1.167.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.43.0",
    "micromatch": "^4.0.8",
    "natural-orderby": "^5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-highlight-words": "^0.21.0",
    "react-virtuoso": "^4.18.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-highlight-words": "^0.20.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "rollup": "^4.59.0",
    "browserslist": "^4.28.7",
    "brace-expansion": "^5.0.8"
  }
}
